{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python tools/hook_bridge.py cursor sessionStart --root ."
      }
    ],
    "sessionEnd": [
      {
        "command": "python tools/hook_bridge.py cursor sessionEnd --root ."
      }
    ],
    "subagentStop": [
      {
        "command": "python tools/hook_bridge.py cursor subagentStop --root ."
      }
    ]
  }
}
